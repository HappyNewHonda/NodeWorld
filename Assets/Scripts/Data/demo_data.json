: 1 }},{"Id":1,"Type":"WaitClick","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 1 }},{"Id":1,"Type":"PrefabDelete","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 1 }},{"Id":1,"Type":"PrefabLoad","Parameter":"BroadcastPrefab","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowMessage","Parameter":"──本日をもって、暫定統治期間は終了となります。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"長い混乱の時代でした。\n多くのものが失われました。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"しかし、私たちはまだここにいます。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"DeleteMessage","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"国は本日付で、各区画への「調律者」派遣を正式に開始します。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"調律者は、皆さんの暮らしを立て直す技術支援者です。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"配属先の区画では、住民の声を聞き、\nインフラを再構築する権限が与えられます。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"DeleteMessage","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"私たちに残された資源は、決して豊かではありません。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"ですが、正しく配り、\n正しくつなげば、人は再び立ち上がれます。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"どうか調律者を信じ、共に歩んでください。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"DeleteMessage","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowMessage","Parameter":"……なお、調律者への要望・相談は各区の掲示板へ。\nあなたの声が、明日のこの街をつくります。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"DeleteMessage","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"PrefabDelete","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"WaitDelayMillSec","Parameter":"1000","Postion":{ "x": 0, "y": 0, "z": 0 }},{"Id":1,"Type":"ShowAI","Parameter":"LUMI","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"消え","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"……起動確認。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"無","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"生体認証……完了。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"通常","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"はじめまして、調律者さま。\n支援AIのリュミです。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"さっきの放送、聞こえていましたか？","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"呆れ","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"「共に歩んでください」\n──なかなか立派なことを言いますよね。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"困り顔","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"でも、実際に泥をかぶるのは、ぼくらの方です。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"通常","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"ここは第7居住区。通称「ナナク」。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"小さな区画ですが……\n正直、状態は良くないです。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"水も、電気も、\nまともに通っていません。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"笑顔","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"でも、人はいます。\n瓦礫の中で、それでも暮らしている人たちが。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"通常","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"さて──あちらが「掲示板」です。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"住民の声は中央で取りまとめられ、\n依頼としてここに届きます。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"調律者さまは、この依頼を読んで、叶えていく。\nそれがお仕事です。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ChangeAIImage","Parameter":"驚き","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"ShowAIText","Parameter":"最初の依頼がもう届いているようですね。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"水と電気──\n生活の最低限です。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"ShowAIText","Parameter":"ぼくがつなぎ方を案内しますから、\n一緒にやりましょう。","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"DeleteAIText","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 3 }},{"Id":1,"Type":"DeleteAI","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 2 }},{"Id":1,"Type":"PrefabLoad","Parameter":"NewspaperSmallPrefab","Postion":{ "x": 0, "y": 0, "z": 4 }},{"Id":1,"Type":"ShowMessage","Parameter":"ナナク日報（号外）「ついに調律者が着任──第7居住区にも復興の光」","Postion":{ "x": 0, "y": 0, "z": 5 }},{"Id":1,"Type":"ShowMessage","Parameter":"長らく放置されていた当区にも、ようやく調律者が配属された。","Postion":{ "x": 0, "y": 0, "z": 5 }},{"Id":1,"Type":"ShowMessage","Parameter":"住民からは期待の声が上がっている。水処理・発電設備の稼働が最優先とのこと。","Postion":{ "x": 0, "y": 0, "z": 5 }},{"Id":1,"Type":"DeleteMessage","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 5 }},{"Id":1,"Type":"PrefabDelete","Parameter":"","Postion":{ "x": 0, "y": 0, "z": 4 }},{"Id":2,"Type":"AddNode","Parameter":"3","Postion":{ "x": -175, "y": 275, "z": 0 }},{"Id":2,"Type":"AddNode","Parameter":"4","Postion":{ "x": 225, "y": 25, "z": 0 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": -500, "y": 650, "z": 1 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": -1050, "y": 450, "z": 2 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": -1175, "y": 125, "z": 3 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": -1000, "y": -250, "z": 4 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": -550, "y": -475, "z": 5 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": 75, "y": 675, "z": 6 }},{"Id":2,"Type":"AddNode","Parameter":"9","Postion":{ "x": 600, "y": 550, "z": 7 }},{"Id":2,"Type":"AddEffect","Parameter":"2","Postion":{ "x": 0, "y": 0, "z": 1 }},{"Id":